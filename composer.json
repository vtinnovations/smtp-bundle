{
    "name": "vtinnovations/smtp-bundle",
    "description": "Contao backend UI to configure SMTP/API mailer — tests credentials, writes to .env.local, clears cache safely",
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "keywords": [
        "contao",
        "smtp",
        "mailer",
        "email",
        "bundle"
    ],
    "homepage": "https://github.com/vtinnovations/smtp-bundle",
    "support": {
        "issues": "https://github.com/vtinnovations/smtp-bundle/issues",
        "source": "https://github.com/vtinnovations/smtp-bundle"
    },
    "authors": [
        {
            "name": "VT Innovations Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-sodium": "*",
        "contao/core-bundle": "^5.3",
        "contao/manager-plugin": "^2.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/dotenv": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/mailer": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/phpunit-bridge": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Vtinnovations\\SmtpBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vtinnovations\\SmtpBundle\\Tests\\": "tests/",
            "Vtinnovations\\SmtpBundle\\Tools\\": "tools/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Vtinnovations\\SmtpBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "sort-packages": true
    }
}
